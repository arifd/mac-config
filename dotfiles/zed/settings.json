// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "format_on_save": "on",
  "auto_install_extensions": {
    "catppuccin": true,
    "dockerfile": true,
    "html": true,
    "git-firefly": true,
    "just": true,
    "nix": true,
    "path-server-lsp": true,
    "pylsp": true,
    "sql": true,
    "swift": true,
    "package-swift-lsp": true,
    "toml": true,
  },
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "right",
  },
  "search": {
    "case_sensitive": true,
  },
  "theme": "Catppuccin Mocha",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "inlay_hints": {
    "enabled": true,
  },
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "buffer_font_family": "FiraCode Nerd Font",
  "lsp": {
    "bash-language-server": {
      "initialization_options": {
        // HACK: We can not tell Zed to use a different linter for zsh files,
        //       unfortunately. So hide ShellCheck's warning that it does not
        //       support zsh, with the understanding that it is still _mostly_
        //       useful.
        "shellcheckArguments": ["--exclude=SC1071"],
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": true,
        "check": {
          "command": "clippy",
        },
        "cargo": {
          // Prevent cargo + rust-analyzer from locking the same target/ directory.
          "targetDir": "target/rust-analyzer",
          "features": "all",
        },
        "inlayHints": {
          "maxLength": null,
          "lifetimeElisionHints": {
            "useParameterNames": true,
            "enable": "skip_trivial",
          },
          "closureReturnTypeHints": {
            "enable": "always",
          },
        },
      },
    },
  },
  "languages": {
    "Nix": {
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": ["-"],
        },
      },
    },
    "TOML": {
      "formatter": {
        "external": {
          "command": "taplo",
          "arguments": ["fmt", "-"],
        },
      },
    },
    "Swift": {
      "formatter": "language_server",
    },
  },
}
